{
  "name": "cypress-fail-on-console-error",
  "version": "6.1.0",
  "description": "fail cypress test on console error",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "npx rimraf dist/ && tsc",
    "prepack": "npm run build",
    "prettier": "prettier --write \"**/*\"",
    "lint": "tsc --noEmit && tsc -p ./test/tsconfig.json && tsc -p ./cypress/tsconfig.json",
    "test": "npm run test:ut && npm run test:e2e && npm run test:cmp",
    "test:ut": "vitest run unit.test.ts",
    "test:e2e": "vitest run e2e.test.ts",
    "test:cmp": "vitest run component.test.ts",
    "verify": "npm run build && npm run lint && npm run ci:prettier && npm run test",
    "ci:prettier": "prettier --check \"**/*\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nils-hoyer/cypress-fail-on-console-error.git"
  },
  "funding": "https://github.com/sponsors/nils-hoyer",
  "keywords": [
    "cypress",
    "testing",
    "console",
    "e2e",
    "component"
  ],
  "author": "nils-hoyer",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/nils-hoyer/cypress-fail-on-console-error/issues"
  },
  "homepage": "https://github.com/nils-hoyer/cypress-fail-on-console-error#readme",
  "devDependencies": {
    "@cypress/mount-utils": "^5.0.0",
    "@types/mocha": "10.0.10",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sinon": "22.0.0",
    "@types/sinon-chai": "4.0.0",
    "cypress": "16.1.1",
    "mocha": "12.0.3",
    "prettier": "3.9.9",
    "prettier-plugin-organize-imports": "4.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rimraf": "6.1.3",
    "sinon": "22.1.0",
    "sinon-chai": "4.0.1",
    "typescript": "7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "peerDependencies": {
    "cypress": ">=14.0.0"
  }
}
